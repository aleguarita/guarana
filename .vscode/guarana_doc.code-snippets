{
	// Place your guarana workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Nova página de documentação": {
		"prefix": "docread",
		"scope": "html, django-html",
		"body": [
			"{% extends '_modelo.html' %}",
			"",
			"{% block conteudo %}",
			"<article class='conteudo__artigo' id='$1' data-categoria='${2|util,ferramentas,facilitadores,base|}'>",
			"    <header class='conteudo__header'>",
			"        <h1>$3</h1>",
			"        <p>$4</p>",
			"    </header>",
			"",
			"    <section class='conteudo__corpo'>",
			"        <p>",
			"            $5",
			"        </p>",
			"    </section>",
			"</article>",
			"{% endblock conteudo %}"
		],
		"description": "Nova página html da documentação"
	},
	"Snippet Codigo": {
		"prefix": "codigo",
		"scope": "html, django-html",
		"body": [
			"{{codigo('$1', [$2])}}"
		],
		"description": "Macro para inserir código"
	},
	"Link MDN": {
		"prefix": "mdn",
		"scope": "html, django-html",
		"body": [
			"<a href=\"$1\" target=\"_blank\" class=\"link_externo\">",
			"    <img src=\"{{ url_for('static', filename='img/mdn.svg') }}\" alt=\"MDN\">",
			"    $2",
			"</a>",
		]
	},
	"Dica snippet": {
		"prefix": "snippet",
		"scope": "html, django-html",
		"body": [
			"<blockquote class='dica-snippet'>",
			"    <p>Snippet</p>",
            "    <p>O {{app}} vem com um snippet para inserir $1: <code>gua_$2</code></p>",
        	"</blockquote>",
		],
		"description": "Aplica a dica para snippet"
	}

}