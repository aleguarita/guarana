{
    "Aplicar Tema": {
        "scope": "javascript",
        "prefix": "gua_aplicar_tema",
        "body": [
            "guaAplicarTema('$1')"
        ],
        "description": "Remove todos os temas do body e aplica o tema selecionado."
    },
    "Remover Temas": {
        "scope": "javascript",
        "prefix": "gua_remover_temas",
        "body": [
            "guaRemoverTemas()"
        ],
        "description": "Remove todos os temas do body."
    },
    "Ativar ou Desativar": {
        "scope": "javascript",
        "prefix": "gua_ativar",
        "body": [
            "guaAtivarDesativar('$1')"
        ],
        "description": "Aplica ou retira a classe `ativo` ao clicar em um item com a classe passada como parâmetro"
    }
}